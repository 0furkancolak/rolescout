POSTGRES_DB=rolescout
POSTGRES_USER=rolescout
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Local API execution from the api/ directory:
DATABASE_URL=postgres://rolescout:replace-with-a-local-password@127.0.0.1:5432/rolescout?sslmode=disable
API_HOST=127.0.0.1
API_PORT=8080
MIGRATIONS_DIR=migrations

# Authentication (see docs/adr/0002-authentication.md)
# The first account can always register; later sign-ups need ALLOW_REGISTRATION=true.
ALLOW_REGISTRATION=false
# Keep true behind HTTPS. Compose defaults to false for local HTTP.
COOKIE_SECURE=false
SESSION_TTL=720h

# How often the worker checks for job sources that are due to sync.
WORKER_TICK=1m

# Client address handling and abuse limits (see docs/api/README.md).
# Compose trusts X-Real-IP from private networks, where nginx runs.
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5

# debug, info, warn or error. Logs are JSON lines on stdout.
LOG_LEVEL=info

# Host port of the web app in Docker Compose.
WEB_PORT=4173

# Career page research (see docs/configuration.md). Defaults shown.
# CRAWL_CONCURRENCY=16
# CRAWL_HOST_INTERVAL=1s
# CRAWL_VENDOR_CONCURRENCY=4
# CRAWL_ALLOW_PRIVATE=false
# DISCOVERY_INTERVAL=168h
# COMPANY_SYNC_INTERVAL=12h
# RESEARCH_INTERVAL=12h
# MATCH_MIN_SCORE=40
# CLOSED_JOB_RETENTION=2160h

# Optional local language model (see docs/configuration.md). Off by default.
# Run Ollama on the host: Docker on a Mac cannot use the Apple GPU.
# LLM_ENABLED=false
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LLM_FALLBACK_MODEL=qwen3:1.7b-q4_K_M
# LLM_API_KEY=
# LLM_TIMEOUT=60s
# LLM_CONCURRENCY=1
# LLM_BATCH=25
# LLM_MAX_INPUT_CHARS=6000
# LLM_MAX_OUTPUT_TOKENS=400
